 (CELL
  (CELLTYPE "SwitchMatrixMultiplexer_inv")
  (INSTANCE u_custom_cells\.u_final_mux\.SwitchMatrixMultiplexer_inv_inst)
  (DELAY
   (ABSOLUTE
    (COND !SEL&!D == 1'b1
     (IOPATH A X (0.116:0.116:0.116)))
    (COND !SEL&!D == 1'b1
     (IOPATH A X () (0.119:0.119:0.119)))
    (COND SEL&D == 1'b1
     (IOPATH B X (0.156:0.156:0.156)))
    (COND SEL&D == 1'b1
     (IOPATH B X () (0.119:0.119:0.119)))
   )
  )
 )
 (CELL
  (CELLTYPE "latch")
  (INSTANCE u_custom_cells\.u_latch0\.latch_inst)
  (DELAY
   (ABSOLUTE
    (COND GATE == 1'b1
     (IOPATH D Q () (0.000:0.000:0.000)))
    (COND GATE == 1'b1
     (IOPATH D Q (0.000:0.000:0.000)))
    (COND !D == 1'b1
     (IOPATH GATE Q () (0.224:0.224:0.224)))
    (COND D == 1'b1
     (IOPATH GATE Q (0.167:0.167:0.167)))
   )
  )
  (TIMINGCHECK
    (HOLD (negedge D) (negedge GATE) (-0.153:-0.154:-0.156))
    (HOLD (posedge D) (negedge GATE) (-0.215:-0.215:-0.215))
    (SETUP (negedge D) (negedge GATE) (0.155:0.156:0.158))
    (SETUP (posedge D) (negedge GATE) (0.215:0.215:0.216))
  )
 )
